// Cloudflare Workers config for the pinfold.page website.
// The site is plain static files in site/; there is no Worker script.
// Security headers come from site/_headers.
{
  "name": "pinfold",
  "compatibility_date": "2026-10-26",
  // Serve only on pinfold.page (custom domain set in the dashboard), not on workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  }
}
